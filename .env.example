# Server
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/njin

# S3 storage (S3 / R2 / Spaces / MinIO)
S3_BUCKET=my-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.example.com

# Image optimization: comma-separated external hosts allowed for GET /img besides same-origin/localhost
IMG_HOSTS=
