          <div x-show="tab === 'admin'" x-cloak class="h-full overflow-hidden">
            @!component('components/shot', { name: 'article-edit-mobile', alt: 'The Article edit form in the njin admin panel.', w: 1000, dark: true, cls: 'w-full' })
          </div>
          <div x-show="tab === 'site'" x-cloak class="py-4 font-mono text-[13px] leading-relaxed text-fg">
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">1</span><span class="whitespace-pre"><span class="tk-kw">&#64;let</span>(item = await article.published.show(params.id, &#123; locale: <span class="tk-str">'en'</span> }))</span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">2</span><span class="whitespace-pre"><span class="tk-kw">&#64;if</span>(!item)</span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">3</span><span class="whitespace-pre">  <span class="tk-mu">&#123;&#123; abort(404) }}</span></span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">4</span><span class="whitespace-pre"><span class="tk-kw">&#64;end</span></span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">5</span><span class="whitespace-pre"> </span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">6</span><span class="whitespace-pre"><span class="tk-fn">&lt;article</span> class=<span class="tk-str">"mx-auto max-w-narrow"</span>&gt;</span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">7</span><span class="whitespace-pre">  <span class="tk-fn">&lt;h1</span>&gt;<span class="tk-mu">&#123;&#123; item.title }}</span><span class="tk-fn">&lt;/h1</span>&gt;</span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">8</span><span class="whitespace-pre">  <span class="tk-fn">&lt;p</span>&gt;<span class="tk-mu">&#123;&#123; item.author.name }}</span><span class="tk-fn">&lt;/p</span>&gt;</span></div>
