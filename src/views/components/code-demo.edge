{{-- Code demo: left = one schema (lines dim unless the active output uses them), right = what njin generates from it. Snippets are pre-highlighted + entity-escaped so Edge does not parse them (see scratchpad gen.py). Token colors: .tk-* in app.css. --}}
<section id="how-it-works" class="relative overflow-hidden border-b border-line">
  <div class="demo-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-page overflow-hidden border-x border-line px-5 py-section sm:px-8 lg:px-12">

    <div class="max-w-3xl">
      <p class="mb-4"><span class="rounded-tag bg-accent px-1.5 py-0.5 font-mono text-xs font-bold uppercase tracking-eyebrow text-accent-fg">How it works</span></p>
      <h2 class="text-display-sm font-heading text-fg">One model in. Four things out.</h2>
      <p class="mt-5 text-lg text-fg-muted">
        Define a model once. njin turns it into a REST API, an admin panel your team can use, server-rendered pages and tools your AI agents can call, each with validation, drafts, languages and access control already wired up.
      </p>
      <a href="/docs" class="mt-6 inline-flex items-center gap-2 rounded-control bg-secondary px-3 py-2 font-mono text-xs uppercase tracking-eyebrow text-secondary-fg hover:bg-secondary-hover">
        Read the docs {{{ icon('arrow-up-right-duotone', 'size-icon-sm') }}}
      </a>
    </div>

    <div x-data="{ tab: 'api', lit: { api: [3, 4, 5, 7, 8, 15], admin: [4, 5, 7, 8, 9, 10, 11, 12, 15, 16], site: [4, 5, 8, 10, 11, 15], agents: [2, 5, 8] } }" class="stage mt-block flex flex-col items-stretch gap-4 rounded-panel p-2 sm:p-6 lg:flex-row">

      <div class="theme-dark flex min-w-0 flex-col overflow-hidden rounded-card bg-neutral-900 lg:flex-1">
        <div class="tint flex items-center justify-between px-4 py-3 font-mono text-xs text-fg-muted">
          <span>Model</span>
          <span class="text-fg-subtle">src/models/article.ts</span>
        </div>
        <div class="h-104 overflow-auto py-4 font-mono text-[13px] leading-relaxed text-fg">
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(1) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">1</span><span class="whitespace-pre"><span class="tk-kw">const</span> article = <span class="tk-fn">makeModel</span>(<span class="tk-str">"article"</span>, &#123;</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(2) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">2</span><span class="whitespace-pre">  name: <span class="tk-str">"Article"</span>,</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(3) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">3</span><span class="whitespace-pre">  searchFields: [<span class="tk-str">"title"</span>, <span class="tk-str">"author.name"</span>],</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(4) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">4</span><span class="whitespace-pre">  draftable: <span class="tk-kw">true</span>,</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(5) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">5</span><span class="whitespace-pre">  i18n: <span class="tk-kw">true</span>,</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(6) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">6</span><span class="whitespace-pre">  schema: z.<span class="tk-fn">object</span>(&#123;</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(7) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">7</span><span class="whitespace-pre">    slug: <span class="tk-fn">text</span>(&#123; label: <span class="tk-str">"Slug"</span>, unique: <span class="tk-kw">true</span> }),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(8) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">8</span><span class="whitespace-pre">    title: <span class="tk-fn">text</span>(&#123; label: <span class="tk-str">"Title"</span>, localized: <span class="tk-kw">true</span> }),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(9) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">9</span><span class="whitespace-pre">    excerpt: <span class="tk-fn">text</span>(&#123; label: <span class="tk-str">"Excerpt"</span>, localized: <span class="tk-kw">true</span> }),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(10) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">10</span><span class="whitespace-pre">    body: <span class="tk-fn">richtext</span>(&#123; label: <span class="tk-str">"Body"</span>, localized: <span class="tk-kw">true</span> }),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(11) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">11</span><span class="whitespace-pre">    cover: <span class="tk-fn">file</span>(&#123; label: <span class="tk-str">"Cover"</span> }, (z) =&gt; z.<span class="tk-fn">optional</span>()),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(12) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">12</span><span class="whitespace-pre">    category: <span class="tk-fn">select</span>(&#123; label: <span class="tk-str">"Category"</span> }, [<span class="tk-str">"NEWS"</span>, <span class="tk-str">"TUTORIAL"</span>, <span class="tk-str">"RELEASE"</span>]),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(13) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">13</span><span class="whitespace-pre">    isFeatured: <span class="tk-fn">boolean</span>(&#123; label: <span class="tk-str">"Featured?"</span> }, (z) =&gt; z.<span class="tk-fn">default</span>(<span class="tk-kw">false</span>)),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(14) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">14</span><span class="whitespace-pre">    publishDate: <span class="tk-fn">date</span>(&#123; label: <span class="tk-str">"Publish date"</span> }, (z) =&gt; z.<span class="tk-fn">optional</span>()),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(15) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">15</span><span class="whitespace-pre">    author: <span class="tk-fn">relation</span>(&#123; label: <span class="tk-str">"Author"</span>, labelKey: <span class="tk-str">"name"</span> }, author),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(16) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">16</span><span class="whitespace-pre">    tags: <span class="tk-fn">relationMany</span>(&#123; label: <span class="tk-str">"Tags"</span>, labelKey: <span class="tk-str">"label"</span> }, tag),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(17) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">17</span><span class="whitespace-pre">    keywords: <span class="tk-fn">array</span>(&#123; label: <span class="tk-str">"Keywords"</span> }, <span class="tk-fn">text</span>(&#123; label: <span class="tk-str">"Keyword"</span> })),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(18) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">18</span><span class="whitespace-pre">    seo: <span class="tk-fn">object</span>(&#123; label: <span class="tk-str">"SEO"</span> }, &#123;</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(19) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">19</span><span class="whitespace-pre">      metaTitle: <span class="tk-fn">text</span>(&#123; label: <span class="tk-str">"Meta title"</span> }),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(20) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">20</span><span class="whitespace-pre">      metaDescription: <span class="tk-fn">text</span>(&#123; label: <span class="tk-str">"Meta description"</span> }),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(21) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">21</span><span class="whitespace-pre">    }),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(22) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">22</span><span class="whitespace-pre">  }),</span></div>
<div class="flex transition-opacity duration-300" :class="lit[tab].includes(23) ? '' : 'opacity-30'"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">23</span><span class="whitespace-pre">});</span></div>
        </div>
        <p class="tint px-4 py-2.5 text-xs text-fg-muted">Bright lines are what the selected output is built from.</p>
