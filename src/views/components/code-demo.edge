      <div class="theme-dark flex min-w-0 flex-col overflow-hidden rounded-card bg-neutral-900 lg:flex-1">
        <div role="tablist" class="tint flex items-center gap-1 overflow-x-auto px-3 py-2.5">
          <button type="button" role="tab" x-on:click="tab = 'api'" :aria-selected="tab === 'api'" :class="tab === 'api' ? 'bg-surface text-fg' : 'text-fg-muted hover:text-fg'" class="rounded-tag px-2.5 py-1 text-xs font-label whitespace-nowrap">REST API</button>
          <button type="button" role="tab" x-on:click="tab = 'admin'" :aria-selected="tab === 'admin'" :class="tab === 'admin' ? 'bg-surface text-fg' : 'text-fg-muted hover:text-fg'" class="rounded-tag px-2.5 py-1 text-xs font-label whitespace-nowrap">Admin</button>
          <button type="button" role="tab" x-on:click="tab = 'site'" :aria-selected="tab === 'site'" :class="tab === 'site' ? 'bg-surface text-fg' : 'text-fg-muted hover:text-fg'" class="rounded-tag px-2.5 py-1 text-xs font-label whitespace-nowrap">Website</button>
          <button type="button" role="tab" x-on:click="tab = 'agents'" :aria-selected="tab === 'agents'" :class="tab === 'agents' ? 'bg-surface text-fg' : 'text-fg-muted hover:text-fg'" class="rounded-tag px-2.5 py-1 text-xs font-label whitespace-nowrap">Agents</button>
