<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">12</span><span class="whitespace-pre">      <span class="tk-fn">"slug"</span>: <span class="tk-str">"introducing-drafts"</span>,</span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">13</span><span class="whitespace-pre">      <span class="tk-fn">"title"</span>: <span class="tk-str">"Introducing drafts (updated)"</span>,</span></div>
<div class="flex transition-opacity duration-300"><span class="w-8 shrink-0 select-none pr-3 text-right text-fg-subtle">14</span><span class="whitespace-pre">      <span class="tk-fn">"id"</span>: <span class="tk-str">"1n1qci8qksoedxu98vv5"</span></span></div>
