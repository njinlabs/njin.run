                <button type="button" class="rounded-control border-2 border-ink bg-secondary px-4 py-2 text-sm font-label text-secondary-fg outline-2 outline-offset-2 outline-ring">Focused</button>
                <p class="font-mono text-xs uppercase tracking-eyebrow text-fg-muted">outline 2px + offset 2px</p>
              </div>
              <div class="grid grid-cols-4 gap-2 text-fg">
                <p class="text-lg font-heading">Heading</p>
                <p class="text-lg font-title">Title</p>
                <p class="text-lg font-label">Label</p>
                <p class="text-lg font-body">Body</p>
              </div>
            </div>
          </div>
        @end
      @end

      {{-- 11 Layout --}}
      @component('components/slide', { eyebrow: '06 · Layout', title: 'Spacing & width', no: '11 / 12' })
        @slot('main')
          <div class="grid h-full grid-cols-2 gap-6">
            <div class="flex flex-col justify-between rounded-card border border-line bg-surface-raised p-5">
              <p class="text-sm text-fg-muted">Named spacing for page rhythm. Everything else uses the standard 4px scale.</p>
              <div class="flex items-center gap-4"><div class="h-4 w-gutter bg-primary"></div><p class="font-mono text-xs uppercase tracking-eyebrow text-fg-muted">gutter · 24px · px-gutter</p></div>
              <div class="flex items-center gap-4"><div class="h-4 w-block bg-primary"></div><p class="font-mono text-xs uppercase tracking-eyebrow text-fg-muted">block · 48px · gap-block</p></div>
              <div class="flex items-center gap-4"><div class="h-4 w-section bg-primary"></div><p class="font-mono text-xs uppercase tracking-eyebrow text-fg-muted">section · 80px · py-section</p></div>
            </div>
            <div class="flex flex-col justify-between rounded-card border border-line bg-surface-raised p-5">
              <p class="text-sm text-fg-muted">Container widths and breakpoints.</p>
              <div class="space-y-2 font-mono text-xs uppercase tracking-eyebrow text-fg-muted">
                <p><span class="text-fg">max-w-narrow</span> · 768px · articles</p>
                <p><span class="text-fg">max-w-page</span> · 1152px · default</p>
                <p><span class="text-fg">max-w-wide</span> · 1440px · dashboards</p>
              </div>
              <div class="space-y-2 font-mono text-xs uppercase tracking-eyebrow text-fg-muted">
                <p><span class="text-fg">sm</span> 640 · <span class="text-fg">md</span> 768 · <span class="text-fg">lg</span> 1024</p>
                <p><span class="text-fg">xl</span> 1280 · <span class="text-fg">2xl</span> 1536</p>
              </div>
            </div>
          </div>
        @end
      @end

      {{-- 12 Icons --}}
      @component('components/slide', { eyebrow: '07 · Icons', title: 'Phosphor Duotone', no: '12 / 12' })
        @slot('main')
          <div class="flex h-full flex-col justify-between gap-4">
            <p class="text-sm text-fg-muted">
              Phosphor Duotone via Iconify, one weight everywhere. Rendered inline on the server with
              <code class="font-mono text-fg">icon('name-duotone', 'size-icon-md')</code>, colored with text-*.
            </p>
            <div class="grid grid-cols-8 gap-3">
              @each(name in ['house-duotone', 'database-duotone', 'code-duotone', 'palette-duotone', 'gear-duotone', 'users-duotone', 'image-duotone', 'magnifying-glass-duotone', 'plus-duotone', 'pencil-simple-duotone', 'trash-duotone', 'check-duotone', 'x-duotone', 'arrow-right-duotone', 'warning-duotone', 'info-duotone'])
