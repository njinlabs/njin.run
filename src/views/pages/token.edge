                <span class="text-primary">{{{ icon('check-circle-duotone', 'size-icon-lg') }}}</span>
                <span class="text-accent-text">{{{ icon('star-duotone', 'size-icon-lg') }}}</span>
                <span class="text-danger">{{{ icon('warning-duotone', 'size-icon-lg') }}}</span>
