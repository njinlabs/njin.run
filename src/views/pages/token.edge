              {{{ icon('rocket-launch-duotone', 'size-icon-md') }}} <span class="font-mono text-xs">md 20</span>
              {{{ icon('rocket-launch-duotone', 'size-icon-lg') }}} <span class="font-mono text-xs">lg 24</span>
