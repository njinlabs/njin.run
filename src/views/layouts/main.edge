<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  {{--
    Props: description, path (canonical path, e.g. request.path), noindex (true for error pages).
    Slot: title. Titles use "|" as the separator, e.g. "Introduction | njin docs".
  --}}
  @let(origin = 'https://njin.run')
  @let(pageTitle = (((await $slots.title?.()) ?? '').trim()) || 'njin')
  @let(pageDescription = $props.get('description') || 'njin generates a REST API, an admin panel and a server-rendered website from a single Zod model. Built on Bun, Elysia and SurrealDB, for people and AI agents.')
  @let(pagePath = $props.get('path'))
  @let(canonical = pagePath ? origin + pagePath : null)
  @let(ogImage = origin + '/og.png')
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{{ pageTitle }}}</title>
  <meta name="description" content="{{ pageDescription }}" />
  @if($props.get('noindex'))
    <meta name="robots" content="noindex" />
  @else
    <meta name="robots" content="index, follow, max-image-preview:large" />
  @end
  @if(canonical)
    <link rel="canonical" href="{{ canonical }}" />
    <meta property="og:url" content="{{ canonical }}" />
  @end
  <meta name="theme-color" content="#186049" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0f1412" media="(prefers-color-scheme: dark)" />

  <meta property="og:site_name" content="njin" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ pageDescription }}" />
  <meta property="og:image" content="{{ ogImage }}" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="njin: one model, everything else generated." />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ pageDescription }}" />
  <meta name="twitter:image" content="{{ ogImage }}" />

  <link rel="icon" type="image/svg+xml" href="{{ vite.static('favicon.svg') }}" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  {{{ await vite.asset('src/client/app.css') }}}
  {{{ await vite.asset('src/client/main.ts') }}}
</head>
<body class="bg-surface text-fg antialiased">
  {{{ await $slots.main() }}}
</body>
</html>
